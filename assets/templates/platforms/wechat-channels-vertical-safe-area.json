{
  "template_id": "wechat-channels-vertical-safe-area-1080x1920",
  "template_version": "1.0.0",
  "status": "approved-default",
  "platform": {
    "id": "wechat-channels",
    "name_zh": "微信视频号"
  },
  "canvas": {
    "width": 1080,
    "height": 1920,
    "aspect_ratio": "9:16",
    "orientation": "portrait",
    "unit": "px",
    "origin": "top-left"
  },
  "rectangle_semantics": {
    "format": "x-y-width-height",
    "right": "x + width",
    "bottom": "y + height",
    "note": "right 和 bottom 表示边界坐标，不表示可绘制像素索引"
  },
  "safe_area": {
    "name_zh": "统一安全区",
    "x": 100,
    "y": 160,
    "width": 880,
    "height": 1310,
    "right": 980,
    "bottom": 1470,
    "insets": {
      "left": 100,
      "right": 100,
      "top": 160,
      "bottom": 450
    },
    "required_for": [
      "text",
      "title",
      "logo",
      "presenter",
      "face",
      "product",
      "critical-animation",
      "call-to-action"
    ]
  },
  "subtitle_area": {
    "name_zh": "字幕专用区",
    "role": "functional-region-within-safe-area",
    "x": 100,
    "y": 1200,
    "width": 880,
    "height": 270,
    "right": 980,
    "bottom": 1470,
    "exclusive_when_active": true,
    "avoid_behind_subtitles": [
      "face",
      "product-detail",
      "other-text",
      "critical-animation"
    ]
  },
  "subtitle_style": {
    "max_lines": 2,
    "max_chinese_characters_per_line": 15,
    "minimum_font_size_px": 52,
    "stroke_width_px": 2,
    "minimum_contrast_ratio": 4.5,
    "horizontal_align": "center",
    "vertical_align": "center",
    "overflow_policy": "split-caption-or-retime-never-shrink-below-minimum-or-cross-boundary"
  },
  "derived_risk_areas": {
    "top": {
      "x": 0,
      "y": 0,
      "width": 1080,
      "height": 160
    },
    "bottom": {
      "x": 0,
      "y": 1470,
      "width": 1080,
      "height": 450
    },
    "left": {
      "x": 0,
      "y": 0,
      "width": 100,
      "height": 1920
    },
    "right": {
      "x": 980,
      "y": 0,
      "width": 100,
      "height": 1920
    }
  },
  "rules": [
    "所有关键内容的完整包围盒必须位于 safe_area 内",
    "字幕的完整包围盒必须同时位于 safe_area 和 subtitle_area 内",
    "subtitle_area 是 safe_area 内部的功能区，不构成第二套安全边界",
    "背景、纹理、光效和非关键装饰可以铺满整个 canvas",
    "bottom 风险区不得承载任何关键内容",
    "项目存在用户显式配置时，以项目配置为准并记录覆盖来源"
  ],
  "validation": {
    "element_check": "full-bounding-box",
    "safe_area_must_fit_canvas": true,
    "subtitle_area_must_fit_safe_area": true
  },
  "provenance": {
    "approved_date": "2026-08-16",
    "approval": "user-approved skill default",
    "reference": {
      "title": "视频号原生广告竞价推广能力",
      "publisher": "腾讯广告",
      "url": "https://training.tencentads.com/uploads/202306/iiP4sj9B_EQId5g.pdf",
      "note": "官方材料提供9:16裁剪与遮挡风险参考；本模板数值为在该参考和项目实践基础上确认的统一生产标准"
    }
  }
}
