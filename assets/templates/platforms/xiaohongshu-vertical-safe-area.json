{
  "template_id": "xiaohongshu-vertical-safe-area-1080x1920",
  "template_version": "1.0.0",
  "status": "approved-default",
  "platform": {
    "id": "xiaohongshu",
    "name_zh": "小红书"
  },
  "canvas": {
    "width": 1080,
    "height": 1920,
    "aspect_ratio": "9:16",
    "orientation": "portrait",
    "unit": "px",
    "origin": "top-left"
  },
  "rectangle_semantics": {
    "format": "x-y-width-height",
    "right": "x + width",
    "bottom": "y + height",
    "note": "right 和 bottom 表示边界坐标，不表示可绘制像素索引"
  },
  "safe_area": {
    "name_zh": "统一安全区",
    "x": 100,
    "y": 180,
    "width": 820,
    "height": 1360,
    "right": 920,
    "bottom": 1540,
    "insets": {
      "left": 100,
      "right": 160,
      "top": 180,
      "bottom": 380
    },
    "required_for": [
      "text",
      "title",
      "logo",
      "presenter",
      "face",
      "product",
      "critical-animation",
      "call-to-action"
    ]
  },
  "subtitle_area": {
    "name_zh": "字幕专用区",
    "role": "functional-region-within-safe-area",
    "x": 100,
    "y": 1240,
    "width": 820,
    "height": 300,
    "right": 920,
    "bottom": 1540,
    "exclusive_when_active": true,
    "avoid_behind_subtitles": [
      "face",
      "product-detail",
      "other-text",
      "critical-animation"
    ]
  },
  "subtitle_style": {
    "max_lines": 2,
    "max_chinese_characters_per_line": 15,
    "minimum_font_size_px": 52,
    "stroke_width_px": 2,
    "minimum_contrast_ratio": 4.5,
    "horizontal_align": "center",
    "vertical_align": "center",
    "overflow_policy": "split-caption-or-retime-never-shrink-below-minimum-or-cross-boundary"
  },
  "derived_risk_areas": {
    "top": {
      "x": 0,
      "y": 0,
      "width": 1080,
      "height": 180
    },
    "bottom": {
      "x": 0,
      "y": 1540,
      "width": 1080,
      "height": 380
    },
    "left": {
      "x": 0,
      "y": 0,
      "width": 100,
      "height": 1920
    },
    "right": {
      "x": 920,
      "y": 0,
      "width": 160,
      "height": 1920
    }
  },
  "rules": [
    "所有关键内容的完整包围盒必须位于 safe_area 内",
    "字幕的完整包围盒必须同时位于 safe_area 和 subtitle_area 内",
    "subtitle_area 是 safe_area 内部的功能区，不构成第二套安全边界",
    "背景、纹理、光效和非关键装饰可以铺满整个 canvas",
    "right 风险区用于避让新版视频 Feed 的右侧互动栏",
    "bottom 风险区用于避让作者、标题标签、播放器控件和底部导航，不得承载关键内容",
    "项目存在用户显式配置时，以项目配置为准并记录覆盖来源"
  ],
  "validation": {
    "element_check": "full-bounding-box",
    "safe_area_must_fit_canvas": true,
    "subtitle_area_must_fit_safe_area": true
  },
  "provenance": {
    "approved_date": "2026-08-16",
    "approval": "user-approved skill default",
    "official_pixel_standard": false,
    "reference": {
      "title": "小红书 Deeplink 说明：新视频 Feed 页",
      "publisher": "小红书",
      "url": "https://pages.xiaohongshu.com/activity/deeplink",
      "note": "官方公开资料确认视频 Feed 场景，但未发布精确像素安全区；本模板根据当前右侧互动栏和底部信息层形成用户确认的保守生产标准，并非平台强制像素线"
    }
  }
}
